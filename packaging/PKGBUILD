# Maintainer: bhimio1
pkgname=material-3-text-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Light Material 3 code and text editor that follows end4-pC's colors"
arch=('x86_64' 'aarch64')
url="https://github.com/bhimio1/material-3-text"
license=('MIT')
depends=('libxkbcommon' 'wayland' 'libglvnd' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=(
  'polkit: save files you can only write as administrator (pkexec)'
  'glib2: move files to the trash from the sidebar (gio)'
  'xdg-desktop-portal: open and save dialogs'
  'material-3-file-manager: "Show in Files" and the portal file chooser'
)
provides=('material-3-text')
conflicts=('material-3-text' 'material-3-text-bin')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/m3-text "$pkgdir/usr/bin/m3-text"
  install -Dm644 packaging/material_3_text.desktop "$pkgdir/usr/share/applications/material_3_text.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/LICENSE-Inter.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Inter.txt"
}
